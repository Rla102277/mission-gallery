me":"TheStaircase.jpg"},"f4ddd9cd-0980-4aa8-48d3-a681772e0f00":{"id":"f4ddd9cd-0980-4aa8-48d3-a681772e0f00","filename":"The_Grandeur_Seljalandsfoss.jpg"},"f87be321-86c0-4b79-b5e8-6de51301dd00":{"id":"f87be321-86c0-4b79-b5e8-6de51301dd00","filename":"TheSeaStacks-Edit.jpg"},"f9b2dc84-63d9-4142-ab18-618fc1700500":{"id":"f9b2dc84-63d9-4142-ab18-618fc1700500","filename":"TheSilentThreshold-2.jpg"},"faf4ee33-e4c1-4d1b-8534-88eceb288f00":{"id":"faf4ee33-e4c1-4d1b-8534-88eceb288f00","filename":"TheStaircase.jpg"},"fdb510a1-24e4-4678-f7bb-18edb8763000":{"id":"fdb510a1-24e4-4678-f7bb-18edb8763000","filename":"TheFadingLight.jpg"},"ffe5b621-fcfa-47ba-961d-22ba4d269e00":{"id":"ffe5b621-fcfa-47ba-961d-22ba4d269e00","filename":"GFXS4143.jpg"}}},"home":{},"pages":{"home":{"title":"","blocks":[{"id":"h1","data":{"eyebrow":"Fine Art Landscape Photography","tagline":"Beyond the Daydream","variant":"wordmark","scrollText":"Enter","backgroundImage":"cf786493-77cd-48cf-aa19-2804d79fed00"},"type":"hero"},{"id":"h2","data":{"body":"Most of us spend our lives just outside the frame &mdash; scrolling past the image, saving it for later, never quite arriving. I started chasing the places that couldn&rsquo;t be scrolled past.\n\nPhotography is where light becomes language and landscape becomes mirror. The most honest photographs aren&rsquo;t taken &mdash; they&rsquo;re waited for. Cold mornings, uncertain skies, the moment you raise the camera toward impossible light and believe something is there before you can see it.","ctaUrl":"/pages/about.html","ctaText":"Read the Full Statement","eyebrow":"The Vision","heading":"The arch frames what lies beyond.<br>Every image is a gateway.","variant":"default"},"type":"text"},{"id":"h3","data":{},"type":"divider"},{"id":"h4","data":{"ctaUrl":"/pages/galleries.html","ctaText":"View All","heading":"Four bodies of work.<br>One way of seeing."},"type":"collections-grid"},{"id":"h5","data":{"eyebrow":"Signature Projects","heading":"Work that required commitment to earn."},"type":"featured-list"},{"id":"h6","data":{},"type":"divider"},{"id":"h7","data":{"items":[{"body":"Locations are studied before they&rsquo;re visited. Weather patterns, golden hour windows, seasonal light &mdash; the expedition plan is built around the image, not the schedule. Arriving prepared means arriving open.","title":"Research &amp; Arrival"},{"body":"The GFX system doesn&rsquo;t reward spray-and-pray. 102 megapixels asks you to slow down, choose your moment, and mean it. Technical mastery is what frees you to respond to what you couldn&rsquo;t plan for.","title":"Medium Format Patience"},{"body":"The honest photograph isn&rsquo;t taken &mdash; it&rsquo;s waited for. Sometimes that means three hours in the cold. Sometimes it means coming back on the fifth day. The image that earns its place always knew you were willing to wait.","title":"The Wait"}],"eyebrow":"The Approach","heading":"How the photographs get made."},"type":"process-grid"},{"id":"h8","data":{"body":"Ten participants. Three days. One summit. Guided by resilience speaker Tia Banks and documented through the lens of The Infinite Arch. Applications open through the WE CLIMB initiative.","title":"The Hope Hike","ctaUrl":"/pages/hope-hike.html","ctaText":"Learn More","eyebrow":"May 29&ndash;31, 2026 &middot; Guadalupe Mountains, Texas","subtitle":"Adventure Wellness at the Top of Texas"},"type":"callout"},{"id":"h9","data":{"items":[{"body":"Museum-quality archival prints from the expedition collections. Limited editions with certificates of authenticity. Sizes from 16&times;20 to 40&times;60 on premium papers.","price":"From $450 &middot; Worldwide shipping","title":"Fine Art Prints"},{"body":"Custom landscape and architectural photography for commercial clients, publications, and private collectors. Each project begins with a conversation about what you&rsquo;re actually trying to say.","price":"From $2,500 &middot; Custom quotes","title":"Commission Work"},{"body":"Small-group expeditions combining landscape photography instruction with wilderness immersion. Not a photo tour &mdash; a genuine creative expedition into terrain that asks something of you.","price":"From $850 &middot; Limited availability","title":"Adventure Workshops"}],"eyebrow":"Services","heading":"Ways to work together."},"type":"services-grid"},{"id":"h10","data":{"body":"Monthly dispatches from the field &mdash; new collections, Hope Hike news, and early access to limited edition print releases.","eyebrow":"Stay Connected","heading":"New work. Expedition updates.<br>Nothing you didn&rsquo;t ask for.","placeholder":"your@email.com"},"type":"newsletter"},{"id":"h11","data":{"text":"Beautiful things don&rsquo;t ask for attention.","attribution":"Sean O&rsquo;Connell"},"type":"quote"}],"metaDescription":""},"about":{"title":"","blocks":[{"id":"a1","data":{"label":"Artist Statement &nbsp;&middot;&nbsp; Fine Art Landscape Photography","tagline":"Beyond the Daydream","variant":"masthead","backgroundImage":"cb3b4efb-e029-4243-c82e-4ae57d823600"},"type":"hero"},{"id":"a2","data":{"line1":"Most of us spend our lives just outside the frame.","line2":"We scroll past the image, save it for later, and move on. The daydream is the beautiful moment we never quite inhabit.","variant":"pull-quote"},"type":"text"},{"id":"a3","data":{},"type":"divider"},{"id":"a4","data":{"body":"<p>I started chasing the places that couldn’t be scrolled past.</p><p>The Infinite Arch is built on a belief that the most honest photographs aren’t taken — they’re <em>waited for</em>. They come to the photographer who arrives early, stays late, and returns when the light changes. Who understands that the arch in the rock and the arch of a life are describing the same passage: a threshold between what was and what’s possible.</p><p>I shoot with Fujifilm’s GFX medium format system because the format demands presence. You can’t spray and pray at 102 megapixels. You choose your moment, and you mean it. My kit is the GFX 100RF, the GFX 50R, the X-E5, and a Konica Hexar — each one chosen for what it sees, not what it proves.</p><p>This is photography as contemplation. Landscape as mirror. Light as metaphor.</p><p>Sean O’Connell didn’t say <em>number 25 is technically perfect</em> or <em>compositionally superior</em>. He said it was the quintessence of life. The difference matters to me. He was talking about the photograph that captured something true — not flawless, but undeniably alive. That’s the standard I’m chasing. Not the image that impresses, but the one that’s irreplaceable. The one I had to be cold for, had to wait for, had to raise the camera toward the impossible light and believe something was there before I could see it. This is what I came for. This is the quintessence of life.</p>","closing":"Welcome to the other side of the daydream.","variant":"article"},"type":"text"},{"id":"a5","data":{"text":"Beautiful things don’t ask for attention.","attribution":"Sean O’Connell"},"type":"quote"},{"id":"imagetext-1773122608160","data":{"body":"","heading":"","imageId":"efcbe648-d15c-45b3-d3ba-ded684d39d00","imagePosition":"left"},"type":"image-text"}],"metaDescription":""},"portfolio":{"title":"","blocks":[{"id":"pf1","data":{"body":"<p>The Infinite Arch takes its name from two things at once: the natural arch in rock and the arch of a human life. Both describe the same passage — a threshold between what was and what’s possible.</p><p>I shoot with Fujifilm’s GFX medium format system because 102 megapixels demands intention. Every frame is a choice. Every trip into the field is a commitment to be present for whatever the light decides to do.</p><p>This work is landscape as contemplation. The camera is the last step in a process that begins with arriving, waiting, and being willing to return. The image is the record of that patience.</p>","quote":"“The most honest photographs aren’t taken — they’re waited for. They come to the photographer who arrives early, stays late, and returns when the light changes.”","title":"The photograph isn’t made. It’s waited for.","byline":"Randy Allen &nbsp;&middot;&nbsp; <strong>The Infinite Arch</strong> &nbsp;&middot;&nbsp; Fine Art Landscape Photography","eyebrow":"Artist Statement","signature":"— Beyond the Daydream"},"type":"portfolio-statement"},{"id":"pf2","data":{"items":["Fujifilm GFX 100S II","GF 32–64mm f/4","GF 100–200mm f/5.6","Fujifilm X-E5","Instax Mini Evo","Capture One"],"label":"System"},"type":"gear-strip"},{"id":"pf3","data":{"photos":[{"workId":"pw-daydream","assetId":"aa1e2b18-8716-4ce7-b120-3f365aa7cb00","caption":"Test Caption"}],"eyebrow":"Selected Work","heading":"Images from the field."},"type":"curated-grid"},{"id":"pf4","data":{"mode":"auto"},"type":"work-block"},{"id":"pf5","data":{"note":"All series available &nbsp;&middot;&nbsp; Custom sizes on request","title":"Every print is a<br>limited edition.","ctaUrl":"mailto:sayhello@theinfinitearch.com?subject=Print Inquiry","ctaText":"Begin a Conversation","eyebrow":"Original Fine Art Prints","subtitle":"Archival pigment on Hahnemühle Fine Art paper. Each print is signed, numbered, and produced from the original GFX 102-megapixel file."},"type":"inquiry"}],"metaDescription":""}},"photos":{},"series":{},"imgFolders":{},"navigation":[{"href":"/","label":"Home","visible":true},{"href":"/pages/portfolio.html","label":"Portfolio","visible":true},{"href":"/pages/galleries.html","label":"Galleries","visible":true},{"href":"/pages/about.html","label":"About","visible":true},{"href":"/pages/prints.html","label":"Prints","visible":true},{"href":"/pages/contact.html","label":"Contact","visible":true}],"siteSettings":{"email":"","tagline":"Fine Art Photography","siteName":"The Infinite Arch","footerAttr":"The Infinite Arch","footerQuote":"Some landscapes refuse to remain peripheral."},"portfolioWorks":[{"id":"pw-daydream","type":"Expeditions","title":"Beyond the Daydream","camera":"FUJI GFX 100RF, Fuji X-E5, Fuji GFX 50R","format":"Digital","